# Copie para .env e ajuste os valores locais. O .env nunca vai para o git.

# Aplicação (API e worker)
APP_NAME="Ônibus Backend"
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Porta da API no seu computador (docker compose). Mude se a 8000 estiver ocupada.
API_PORT=8000

# Token da API Olho Vivo (portal de desenvolvedores da SPTrans). Usado pelo coletor.
APP_OLHO_VIVO_TOKEN=coloque-seu-token-aqui

# Banco (docker compose). O administrador é dono dos objetos e roda as migrações;
# a aplicação nunca usa esse usuário.
POSTGRES_DB=onibus
POSTGRES_USER=onibus_admin
POSTGRES_PASSWORD=troque-esta-senha-admin

# Porta do banco no seu computador. Mude se a 5432 estiver ocupada.
DB_PORT=5432

# Senhas dos papéis da aplicação: onibus_escrita (coletor e worker) e onibus_leitura (API).
DB_WRITER_PASSWORD=troque-esta-senha-escrita
DB_READER_PASSWORD=troque-esta-senha-leitura
