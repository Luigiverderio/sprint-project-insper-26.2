# Copie para .env e ajuste os valores locais. O .env nunca vai para o git.

# Aplicação (API e worker)
APP_NAME="Ônibus Backend"
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Login da API com o papel onibus_leitura. Veja o provisionamento no README.
APP_API_DATABASE_USER=api_app
APP_API_DATABASE_PASSWORD=troque-esta-senha-da-api
# Login do coletor com o papel onibus_coletor (só insere no bruto). Veja o README.
APP_COLETOR_DATABASE_USER=coletor_app
APP_COLETOR_DATABASE_PASSWORD=troque-esta-senha-do-coletor
# Banco dos serviços. Aponte para o banco local ao rodar a API fora do Compose.
APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=5432
APP_DATABASE_NAME=onibus

# Banco local (docker compose). Escolha uma senha sua: não há valor padrão.
# O usuário do banco é sempre postgres (o pg_partman_bgw precisa dele).
POSTGRES_DB=onibus
POSTGRES_PASSWORD=troque-esta-senha
# Host do banco para o make migrate. O padrão (127.0.0.1) é o banco do Docker.
# POSTGRES_HOST=127.0.0.1

# Portas no seu computador (docker compose). Mude se estiverem ocupadas.
DB_PORT=5432
API_PORT=8000

# Token da API Olho Vivo (portal de desenvolvedores da SPTrans). Usado pelo coletor.
APP_OLHO_VIVO_TOKEN=coloque-seu-token-aqui
