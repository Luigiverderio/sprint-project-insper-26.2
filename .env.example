# Copie para .env e ajuste os valores locais. O .env nunca vai para o git.

# Aplicação (API e worker)
APP_NAME="Ônibus Backend"
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Banco local (docker compose). Escolha uma senha sua: não há valor padrão.
# O usuário do banco é sempre postgres (o pg_partman_bgw precisa dele).
POSTGRES_DB=onibus
POSTGRES_PASSWORD=troque-esta-senha
# Host do banco para o make migrate. O padrão (127.0.0.1) é o banco do Docker.
# POSTGRES_HOST=127.0.0.1

# Portas no seu computador (docker compose). Mude se estiverem ocupadas.
DB_PORT=5432
API_PORT=8000

# Token da API Olho Vivo (portal de desenvolvedores da SPTrans). Usado pelo coletor.
APP_OLHO_VIVO_TOKEN=coloque-seu-token-aqui
